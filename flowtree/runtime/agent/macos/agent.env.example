# ─── Native macOS FlowTree Agent Configuration ───────────────────────
#
# Read by bin/run.sh (via launchd) each time the agent starts. Keep this
# file OUTSIDE any git checkout — it holds a credential. The conventional
# location is ${FLOWTREE_AGENT_HOME}/agent.env, i.e. next to the install
# directory install.sh manages, and install.sh refuses to run without it.
#
# Generate CLAUDE_CODE_OAUTH_TOKEN by running:
#   claude setup-token
# on any machine where you can authenticate in a browser.
#
# ─────────────────────────────────────────────────────────────────────

# Required: Claude Code authentication
CLAUDE_CODE_OAUTH_TOKEN=

# Required: controller address. On the machine that hosts the controller
# stack this is localhost; elsewhere, the controller's Tailscale name.
FLOWTREE_ROOT_HOST=
FLOWTREE_ROOT_PORT=7766

# Identity. The node-id label lets a job target this agent specifically,
# and shows up in the controller's routing logs.
FLOWTREE_NODE_ID=mac-native-1

# Optional: extra node labels (key:value pairs, comma-separated).
# platform:macos is detected automatically — do not add it here.
# FLOWTREE_NODE_LABELS=gpu:metal

# Workspace parent for repository checkouts.
# Default: ${FLOWTREE_AGENT_HOME}/workspace
# FLOWTREE_WORKING_DIR=/Users/worker/flowtree-agent/workspace

# JVM options for the agent process
AGENT_JVM_OPTS=-Xmx2048m

# Git identity for commits
GIT_USER_NAME="Flowtree Coding Agent"
GIT_USER_EMAIL="michael@almostrealism.com"

# Directories put ahead of PATH for the agent and everything it launches.
# launchd starts a service with almost no PATH, so the tools the agent
# shells out to (claude, node, git, mvn, java, python3) must be listed
# here if they are not in the built-in default:
#   /opt/homebrew/bin:/opt/homebrew/opt/openjdk@17/bin:/usr/local/bin:$HOME/.npm-global/bin
# FLOWTREE_AGENT_PATH=/opt/homebrew/bin:/Users/worker/.npm-global/bin
