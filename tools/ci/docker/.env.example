# ─── AR CI Runner Fleet Configuration ─────────────────────────────────
# Copy this file to .env and fill in the values before starting.
#
#   cp .env.example .env
#   $EDITOR .env

# GitHub personal access token with 'repo' and 'admin:org' scopes
# (or fine-grained token with Administration read/write + Actions read)
GITHUB_PAT=ghp_your_token_here

# Registration scope: "repo" (default) registers against a single repository;
# "org" registers at the organization level so every repository in the org can
# share this fleet (subject to the runner group's repository-access policy in
# Org Settings -> Actions -> Runner groups). Use "org" to share a machine
# between common and ringsdesktop.
# RUNNER_SCOPE=org

# GitHub owner (org or user). Always required.
GITHUB_OWNER=almostrealism

# Repository name. Required only when RUNNER_SCOPE=repo; ignored for org scope.
GITHUB_REPO=common

# Runner name prefix — set this per machine so runners are identifiable
# e.g., "mac-studio", "linux-build", "dev-desktop"
# Runners register as <prefix>-1, <prefix>-2, etc.
RUNNER_PREFIX=ar-runner

# Memory limit per container (default: 16g)
# Each runner needs enough for JDK + Maven + AR tests
RUNNER_MEMORY_LIMIT=16g

# CPU limit per container (default: 4 cores)
RUNNER_CPU_LIMIT=4
