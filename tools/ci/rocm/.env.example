# ─── AR OpenCL CI Runner Fleet Configuration ──────────────────────────
# Copy this file to .env and fill in the values before starting.
#
#   cp .env.example .env
#   $EDITOR .env
#
# .env is gitignored. Never commit a filled-in copy.

# GitHub personal access token.
# Org scope (the default) needs admin:org (classic) or the organization
# "Self-hosted runners" read/write permission (fine-grained), with GITHUB_OWNER
# as the token's resource owner.
GITHUB_PAT=ghp_your_token_here

# GitHub owner (org or user)
GITHUB_OWNER=almostrealism

# Registration scope: "org" registers once for the whole organization so other
# repositories can share the machine; "repo" registers against GITHUB_REPO only.
# Org scope additionally requires granting the runner group repository access in
# Org Settings -> Actions -> Runner groups. Without that grant, jobs queue
# forever against a runner that reports healthy.
RUNNER_SCOPE=org

# Only used when RUNNER_SCOPE=repo
GITHUB_REPO=common

# Runner name prefix. Runners register as <prefix>-1, <prefix>-2, etc.
RUNNER_PREFIX=amd-halo

# Runner group. Restrict this group to private repositories, or require approval
# for fork-PR workflow runs, before the runner goes live: this repository is
# public, and a fork PR can otherwise execute arbitrary code on a host that has
# a GPU and a local sample library on it.
RUNNER_GROUP=Default

# ---------- GPU access ----------
#
# Device passthrough, the ROCm bind-mount, and GroupAdd=keep-groups live in
# ar-ci-cl-runner.container, not here — systemd unit files do not interpolate
# environment variables into those fields. Only the build argument below is a
# .env setting, because the ICD is written into the image at build time.

# Absolute path to the ROCm OpenCL runtime as it appears under the mount. Baked
# into the image's ICD entry at build time; changing it requires a rebuild.
#
# It must be absolute. ROCm's own ICD names the library as a bare
# "libamdocl64.so", and since the library sits in lib/opencl/ rather than lib/,
# that name is not on the loader's search path and resolves to nothing.
#
# The default below is the verified path on the therock-gfx1151 platform. If a
# host differs, find it with:
#   cat /opt/rocm/etc/OpenCL/vendors/*.icd     # the filename ROCm expects
#   find /opt/rocm/ -name 'libamdocl*'         # where it actually is
# Express the result under /opt/rocm (the mount point). If /opt/rocm is a
# symlink on the host, do NOT use the resolved target — that path does not exist
# inside the container, and the result is zero platforms with correct-looking
# configuration.
ROCM_OPENCL_LIB=/opt/rocm/lib/opencl/libamdocl64.so

# ---------- Set elsewhere ----------
#
# The sample library mount and the memory/CPU limits are properties of the
# container, so they live in ar-ci-cl-runner.container:
#
#   Volume=/srv/ar-ci/music:/opt/ar-samples:ro
#   MemoryMax=64G
#   CPUQuota=1200%
#
# Seed the library with (from a machine that holds it, as an admin account —
# NOT as the service account, which is login-locked on purpose):
#   tools/ci/sync-music-samples.sh --host <this-host> --user <admin> \
#       --group ar-ci --dest /srv/ar-ci/music
