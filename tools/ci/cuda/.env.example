# ar-ci-cuda runner fleet configuration. Copy to .env (gitignored) and fill in.

# Token with admin:org (classic) for org-scoped registration, or the
# organization "Self-hosted runners" read/write permission (fine-grained).
GITHUB_PAT=

# Registration scope: org (shared across the org) or repo.
RUNNER_SCOPE=org
GITHUB_OWNER=almostrealism
GITHUB_REPO=common

# Runners register as <prefix>-1, <prefix>-2, ...
RUNNER_PREFIX=dgx-spark
RUNNER_GROUP=Default

# Pin an actions/runner release; leave empty to use the latest (fleet.sh resolves it).
RUNNER_VERSION=

# Per-runner limits. The GPU shares the host's unified memory, so the memory
# limit times the runner count must leave room for the host.
RUNNER_MEMORY_LIMIT=48g
RUNNER_CPU_LIMIT=12

# Host paths bind-mounted read-only into each runner.
CUDA_HOME_HOST=/usr/local/cuda
AR_CI_SAMPLES_DIR=/srv/ar-ci/music
