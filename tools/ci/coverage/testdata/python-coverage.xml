<?xml version="1.0" ?>
<!--
  Minimal fixture standing in for coverage.py's `coverage xml` Cobertura
  output. Only the <class filename=".."><lines><line hits=".."> shape
  select-target.py reads is preserved.

  tools/mcp/common: two production files, mixed hits, rolls up below the
  default 80% threshold. A stray test_*.py entry is included to confirm
  parse_python_units skips it defensively (the pipeline is expected to
  configure coverage.py to omit it upstream; this is the safety net).

  tools/mcp/manager: rolls up at/above threshold — not eligible.
-->
<coverage>
  <packages>
    <package name="tools.mcp.common">
      <classes>
        <class filename="tools/mcp/common/foo.py">
          <lines>
            <line number="1" hits="1"/>
            <line number="2" hits="1"/>
            <line number="3" hits="0"/>
            <line number="4" hits="0"/>
          </lines>
        </class>
        <class filename="tools/mcp/common/bar.py">
          <lines>
            <line number="1" hits="1"/>
            <line number="2" hits="0"/>
          </lines>
        </class>
        <class filename="tools/mcp/common/test_foo.py">
          <lines>
            <line number="1" hits="1"/>
            <line number="2" hits="1"/>
            <line number="3" hits="1"/>
            <line number="4" hits="1"/>
            <line number="5" hits="1"/>
            <line number="6" hits="1"/>
            <line number="7" hits="1"/>
            <line number="8" hits="1"/>
            <line number="9" hits="1"/>
            <line number="10" hits="1"/>
          </lines>
        </class>
      </classes>
    </package>
    <package name="tools.mcp.manager">
      <classes>
        <class filename="tools/mcp/manager/baz.py">
          <lines>
            <line number="1" hits="1"/>
            <line number="2" hits="1"/>
            <line number="3" hits="1"/>
            <line number="4" hits="1"/>
            <line number="5" hits="1"/>
            <line number="6" hits="1"/>
            <line number="7" hits="1"/>
            <line number="8" hits="1"/>
            <line number="9" hits="1"/>
            <line number="10" hits="0"/>
          </lines>
        </class>
      </classes>
    </package>
  </packages>
</coverage>
