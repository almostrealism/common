#!/bin/bash
set -euo pipefail

# ─── fleet: one entry point for the self-hosted CI runner fleet ──────
#
#   tools/bin/fleet <platform> <command> [options]
#
# Every platform takes the same everyday commands:
#
#   up [N]       run N runners on this host (default 1), installing or
#                updating them first where the platform needs it; also how to
#                scale an existing fleet up or down
#   down         stop this host's runners, deregistering them from GitHub
#   status       what is running, and whether it is busy
#   logs [-f]    the runners' logs
#
# Platforms:
#   macos   native runners under launchd       (tools/ci/macos/fleet.sh)
#           also: install | uninstall | start | stop | restart  [--instance NAME]
#   rocm    OpenCL runners under systemd/podman (tools/ci/rocm/fleet.sh)
#           also: start [N] | stop [--if-idle] | restart
#   cuda    CUDA runners under Docker Compose   (tools/ci/cuda/fleet.sh)
#
# Each platform reads its credential and settings from the .env beside its
# script (tools/ci/<platform>/.env, from .env.example). Then, for example:
#
#   tools/bin/fleet macos up 2 --store-from michael@mac-studio
#   tools/bin/fleet cuda up 3
#
# `tools/bin/fleet <platform> --help` lists that platform's options.

# /bin/bash by absolute path, like the macOS script this hands off to: the
# macOS install calls sudo, so its shell must not come from an unscreened PATH.
# PATH is anchored to the system directories for the same reason — this
# dispatcher resolves dirname and sed by name before it execs the platform
# script, which re-anchors its own PATH.
PATH="/usr/bin:/bin:/usr/sbin:/sbin:${PATH}"
export PATH

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CI_DIR="$(cd "${SCRIPT_DIR}/../ci" && pwd)"

usage() { sed -n '4,/^$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

PLATFORM="${1:-}"
case "${PLATFORM}" in
    ""|-h|--help|help) usage; exit 0 ;;
    macos|rocm|cuda) shift; exec "${CI_DIR}/${PLATFORM}/fleet.sh" "$@" ;;
    *)
        echo "Unknown platform: ${PLATFORM}" >&2
        echo >&2
        usage >&2
        exit 2
        ;;
esac
