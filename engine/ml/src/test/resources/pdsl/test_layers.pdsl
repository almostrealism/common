// Producer DSL: Transformer Block from Low-Level Primitives
//
// This file defines a complete transformer block (attention + SwiGLU FFN)
// using only primitive operations. Higher-level constructs like "attention"
// and "swiglu_ffn" are composed from these primitives within the DSL.

import "/pdsl/attention.pdsl"

// ----- SwiGLU Feed-Forward Network -----
// Composed from: rmsnorm, dense, silu, product
//
// Architecture:
//   input -> rmsnorm -> split into two paths:
//     path A: dense(w1) -> silu()    (gate)
//     path B: dense(w3)              (up projection)
//   -> element-wise multiply(A, B)
//   -> dense(w2)                     (down projection)

layer swiglu_ffn(
    norm_weights: weight,
    w1: weight,
    w2: weight,
    w3: weight,
    epsilon: float
) -> [1, 64] {
    rmsnorm(norm_weights, epsilon)
    product(
        { dense(w1); silu() },
        { dense(w3) }
    )
    dense(w2)
}

/*
 * ----- Transformer Block -----
 * Composed from the decomposed `attention` layer imported from /pdsl/attention.pdsl
 * and the swiglu_ffn layer defined above, with residual connections (accum):
 *
 *   input -> accum(attention(...)) -> accum(swiglu_ffn(...)) -> output
 *
 * The imported `attention` layer writes out the stages the removed `attention`
 * built-in used to assemble in Java: rmsnorm, the Q/K/V projections, rotary
 * embedding, the KV cache, scores, causal mask, softmax, weighted values and the
 * output projection.
 *
 * The dimensions are fixed to the values the loader tests bind: 4 query heads of
 * 16 (model dimension 64) over a sequence of 32. Multi-head attention passes the
 * query head count as the kv-head count (so the kv_heads parameter is retained for
 * the test's argument map but unused in the body); the projections have no biases
 * (null) and the attention RMSNorm epsilon is 1e-5, the value the built-in used to
 * hardcode. Each forward pass is one token at `position`, and the key and value
 * caches are freshly allocated here, one pair per build.
 */
layer transformer_block(
    heads: int,
    kv_heads: int,
    rms_att_weight: weight,
    wq: weight,
    wk: weight,
    wv: weight,
    wo: weight,
    freq_cis: weight,
    position: scalar,
    rms_ffn_weight: weight,
    w1: weight,
    w2: weight,
    w3: weight,
    epsilon: float
) -> [1, 64] {
    accum {
        attention(heads, heads, 16, rms_att_weight, wq, wk, wv, wo,
                  null, null, null, freq_cis, position, 1e-5,
                  zeros([32, 64]), zeros([32, 64]))
    }

    accum {
        swiglu_ffn(rms_ffn_weight, w1, w2, w3, epsilon)
    }
}

// ----- Simple Dense + Activation layer -----
// Demonstrates basic composition of primitives.

layer dense_relu(
    weights: weight,
    biases: weight
) -> [1, out_dim] {
    dense(weights, biases)
    relu()
}

// ----- RMSNorm + Dense layer -----
// Demonstrates norm -> projection pattern.

layer normed_projection(
    norm_weights: weight,
    proj_weights: weight,
    epsilon: float
) -> [1, out_dim] {
    rmsnorm(norm_weights, epsilon)
    dense(proj_weights)
}
