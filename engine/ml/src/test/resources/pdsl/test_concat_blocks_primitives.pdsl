/**
 * Fixtures for the concat_blocks backward pass. The first layer concatenates two trainable dense
 * parts, the second starting with a slice, so one forward then one backward pass exercises the
 * concat backward (each part receives the slice of the output gradient for its segment) together
 * with the slice backward (a part that reads only the first elements of the input contributes its
 * input gradient to those positions alone).
 */

/**
 * [in_size] -> [out_a + out_b]: concat of a dense over the whole input and a dense over its first
 * `hidden_size` elements.
 *
 *   concat_blocks
 *     dense(weight_a)                 a = W_a · x               [out_a]
 *     slice(0, hidden_size)           the first hidden_size inputs
 *     dense(weight_b)                 b = W_b · x[0:hidden_size] [out_b]
 */
layer concat_grad(in_size: int, hidden_size: int, weight_a: weight, weight_b: weight) -> [in_size] {
    concat_blocks(
        { dense(weight_a) },
        { slice(0, hidden_size); dense(weight_b) }
    )
}

/** A caller-owned [rows, size] cache that concat_read_grad reads. */
state concat_cache_state {
    row_cache: weight
}

/**
 * [in_size] -> [out_a + size]: the shape of a recurrent cell's [f(x) | h] input — a trainable dense
 * part concatenated with an inline cache_read part. The cache_read part does not read the input:
 * it receives its segment of the output gradient, trains nothing, and contributes nothing to the
 * input gradient.
 *
 *   concat_blocks
 *     dense(weight_a)                 a = W_a · x               [out_a]
 *     cache_read(row_cache, position) row `position` of the cache [size]
 */
layer concat_read_grad(in_size: int, position: scalar, weight_a: weight) -> [in_size] {
    concat_blocks(
        { dense(weight_a) },
        { cache_read(row_cache, position) }
    )
}
