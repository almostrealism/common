/**
 * Fixtures for add(other), the element-wise sum of the stage input and a second operand: a tensor the
 * caller binds, or a branch the layer splits off from its own signal.
 *
 *   add_tensor(other)                      x + other, other a bound tensor of the input's shape
 *   add_branch(main_factor, branch_factor)  main_factor * x + branch_factor * x, the second term
 *                                           computed in a branch: both terms carry gradient
 *   add_dense_branch(weights)              x + weights · x, the projection computed in a branch, so
 *                                           its weights are trained through the sum
 *   add_branch_reused(factor)              one branch read by two add stages, rejected as reuse
 *   add_branch_wrong_shape(size)           a branch holding only the first row, rejected as an operand
 *   add_without_operand()                  add() with no operand, rejected
 */

layer add_tensor(other: weight) {
    add(other)
}

layer add_branch(main_factor: float, branch_factor: float) {
    branch scaled {
        scale(branch_factor)
    }
    scale(main_factor)
    add(scaled)
}

layer add_dense_branch(weights: weight) {
    branch projected {
        dense(weights)
    }
    add(projected)
}

layer add_branch_reused(factor: float) {
    branch scaled {
        scale(factor)
    }
    add(scaled)
    add(scaled)
}

layer add_branch_wrong_shape(size: int) {
    branch first_row {
        slice([1, size], 0, 0)
    }
    add(first_row)
}

layer add_without_operand() {
    add()
}
