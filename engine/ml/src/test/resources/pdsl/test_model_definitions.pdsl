// model blocks below reference layers from test_layers.pdsl, so this file
// is parsed as a suffix to that fixture's source rather than on its own.

model swiglu_ffn_model(
    norm_weights: weight,
    w1: weight,
    w2: weight,
    w3: weight,
    epsilon: float
) {
    swiglu_ffn(norm_weights, w1, w2, w3, epsilon)
}
