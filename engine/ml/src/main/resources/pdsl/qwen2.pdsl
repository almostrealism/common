/**
 * Qwen2 / Qwen2.5 decoder (for example Qwen2.5-0.5B-Instruct): the whole forward pass of one
 * token, from its embedding to one score per vocabulary entry.
 *
 * The input is the token's row of the embedding table, model.embed_tokens.weight, which the
 * caller looks up. Everything after that is here:
 *
 *   x                                                       [1, dim]   the residual stream
 *   for each layer i:
 *     x = x + attention(rmsnorm(x))                         [1, dim]   reads earlier tokens
 *     x = x + swiglu_ffn(rmsnorm(x))                        [1, dim]
 *   rmsnorm(x)                                              [1, dim]
 *   dense(embedding table)                                  [1, vocab] one score per token
 *
 * rope holds the rotation angle of every position, shared by the rotary embeddings of all
 * layers. Each layer gets its own memory of the keys and values of every earlier token (its
 * KV cache) from the two zeros(...) arguments, and extends it by one row per token. The output
 * projection reuses the embedding table: the score of each vocabulary entry is how closely its
 * embedding matches the final residual stream.
 *
 * Every weight is read from the checkpoint by its Hugging Face name, so each line can be
 * matched against the model card or a PyTorch implementation. The layers it calls are written
 * out in transformer.pdsl, attention.pdsl and feed_forward.pdsl.
 *
 * Arguments:
 *   settings  dim, layers, heads, kv_heads, seq_len and rope_theta of the checkpoint
 *   weights   the checkpoint
 *   position  the index of the current token in the sequence
 */

import "/pdsl/transformer.pdsl"

model qwen2(settings: model_settings, weights: checkpoint, position: scalar) {
    let rope = rope_freqs(settings.rope_theta, settings.dim / settings.heads, settings.seq_len)

    for i in 0..settings.layers {
        transformer(settings.heads, settings.kv_heads, settings.dim / settings.heads,
                    weights["model.layers.{i}.input_layernorm.weight"],
                    weights["model.layers.{i}.self_attn.q_proj.weight"],
                    weights["model.layers.{i}.self_attn.k_proj.weight"],
                    weights["model.layers.{i}.self_attn.v_proj.weight"],
                    weights["model.layers.{i}.self_attn.o_proj.weight"],
                    weights["model.layers.{i}.self_attn.q_proj.bias"],
                    weights["model.layers.{i}.self_attn.k_proj.bias"],
                    weights["model.layers.{i}.self_attn.v_proj.bias"],
                    rope, position,
                    weights["model.layers.{i}.post_attention_layernorm.weight"],
                    weights["model.layers.{i}.mlp.gate_proj.weight"],
                    weights["model.layers.{i}.mlp.down_proj.weight"],
                    weights["model.layers.{i}.mlp.up_proj.weight"],
                    1e-6,
                    zeros([settings.seq_len, settings.dim]), zeros([settings.seq_len, settings.dim]))
    }

    rmsnorm(weights["model.norm.weight"], 1e-6)
    dense(weights["model.embed_tokens.weight"])
}
