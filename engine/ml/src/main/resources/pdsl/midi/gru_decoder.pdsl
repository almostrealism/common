/**
 * GRU decoder of the Moonbeam MIDI model: the per-note decode that turns one transformer
 * hidden state into the seven tokens of a compound MIDI event (sos, onset, duration, octave,
 * pitch class, instrument, velocity), one token per decode step.
 *
 * This file replaces the Java assembly that used to live in GRUDecoder.ensureCompiled, which
 * built every GRU layer as one fused producer lambda and threaded the hidden states through
 * the step model's input and output vector ([x | h_0 .. h_L-1] -> [h_0' .. h_L-1' | logits]).
 * GRUDecoder now only binds the checkpoint weights, allocates the hidden state, builds and
 * compiles the layers below, and runs the decode loop: choosing a token from the logits and
 * looking up its embedding happen between forward passes, so they stay in Java.
 *
 * Two models are built from this file. The start model runs once per note, the step model
 * once per decode step:
 *
 *   start                                        step
 *
 *   [transformer_hidden]                         [input_size] embedding of the previous token
 *     └─ gru_decoder_start                         └─ gru_decoder_layer   (once per GRU layer l)
 *          dense(summary)       [hidden_size]            concat_blocks: x, cache_read(hidden, l)
 *          cache_write × L      hidden[l] = h            gru_cell                 [hidden_size]
 *                                                        cache_write(hidden, l)   hidden[l] = h_l'
 *                                                  └─ gru_decoder_logits[_fc_out]
 *                                                        [dense(fc_out)], dense(lm_head)
 *                                                                                 [decode_vocab_size]
 *
 * The hidden state is caller-owned state of shape [L, hidden_size]: row l holds GRU layer l's
 * hidden state. It persists across the forward passes of one note. The start model writes the
 * summary projection into every row; in every step, layer l reads its row before it runs and
 * writes its new hidden state back afterwards, and that new hidden state is also the input of
 * layer l + 1. Stages run in order, so a row is read before the same layer overwrites it.
 */

/** The GRU hidden state: [num_layers, hidden_size], row l holds layer l's hidden state. */
state gru_decoder_state {
    hidden: weight
}

/**
 * Start of a note: [transformer_hidden] -> [hidden_size]. The transformer's hidden state is
 * projected to the decoder's hidden size, and the projection becomes the initial hidden state
 * of every GRU layer.
 *
 *   dense(summary_weight, summary_bias)   h = W_s · hidden + b_s      [hidden_size]
 *   cache_write(hidden, l), every l       hidden[l] = h, passed through
 */
layer gru_decoder_start(num_layers: int, summary_weight: weight, summary_bias: weight) {
    dense(summary_weight, summary_bias)
    for l in 0..num_layers {
        cache_write(hidden, l)
    }
}

/**
 * One GRU layer of a decode step: [input_size] -> [hidden_size]. The layer's previous hidden
 * state is row layer_index of the decoder state; its new hidden state replaces that row and
 * flows on as the input of the next layer (or of the logits head after the last layer).
 *
 *   concat_blocks                         [x | h_l]     [input_size + hidden_size]
 *     identity                              x, the layer input
 *     cache_read(hidden, layer_index)       h_l, the hidden state from the previous step
 *   gru_cell                              h_l'          [hidden_size]
 *   cache_write(hidden, layer_index)      hidden[layer_index] = h_l', passed through
 */
layer gru_decoder_layer(layer_index: int, input_size: int, hidden_size: int,
                        weight_ih: weight, weight_hh: weight,
                        bias_ih: weight, bias_hh: weight) {
    concat_blocks(
        { identity() },
        { cache_read(hidden, layer_index) }
    )
    gru_cell(weight_ih, weight_hh, bias_ih, bias_hh, input_size, hidden_size)
    cache_write(hidden, layer_index)
}

/**
 * One GRU cell step, [x | h] -> h' ([input_size + hidden_size] -> [hidden_size]), in the
 * formulation of torch.nn.GRU over its stacked checkpoint weights: weight_ih holds
 * [W_ir; W_iz; W_in] ([3 * hidden_size, input_size]), weight_hh holds [W_hr; W_hz; W_hn]
 * ([3 * hidden_size, hidden_size]), and bias_ih and bias_hh are stacked the same way.
 *
 *   gi = W_ih · x + b_ih           [3 * hidden_size]   the input's reset, update and candidate terms
 *   gh = W_hh · h + b_hh           [3 * hidden_size]   the hidden state's terms, in the same order
 *   r  = sigmoid(gi_r + gh_r)      reset gate
 *   z  = sigmoid(gi_z + gh_z)      update gate
 *   n  = tanh(gi_n + r ⊙ gh_n)     candidate state
 *   h' = n + z ⊙ (h − n)           that is (1 − z) ⊙ n + z ⊙ h
 *
 * The first stage lays the terms out as [gi | gh | h] ([7 * hidden_size]); the gates below
 * read them from that layout by offset. The second stage forms [n | z | h] for the lerp.
 */
layer gru_cell(weight_ih: weight, weight_hh: weight, bias_ih: weight, bias_hh: weight,
               input_size: int, hidden_size: int) -> [input_size + hidden_size] {
    concat_blocks(
        { slice(0, input_size); dense(weight_ih, bias_ih) },
        { slice(input_size, hidden_size); dense(weight_hh, bias_hh) },
        { slice(input_size, hidden_size) }
    )
    concat_blocks(
        { gru_candidate(hidden_size) },
        { gru_update_gate(hidden_size) },
        { slice(6 * hidden_size, hidden_size) }
    )
    lerp(hidden_size)
}

/**
 * Reset gate over [gi | gh | h]: r = sigmoid(gi_r + gh_r), [7 * hidden_size] -> [hidden_size].
 *
 *   accum_blocks   gi_r (offset 0) + gh_r (offset 3 * hidden_size)
 *   sigmoid
 */
layer gru_reset_gate(hidden_size: int) -> [7 * hidden_size] {
    accum_blocks(
        { slice(0, hidden_size) },
        { slice(3 * hidden_size, hidden_size) }
    )
    sigmoid()
}

/**
 * Update gate over [gi | gh | h]: z = sigmoid(gi_z + gh_z), [7 * hidden_size] -> [hidden_size].
 *
 *   accum_blocks   gi_z (offset hidden_size) + gh_z (offset 4 * hidden_size)
 *   sigmoid
 */
layer gru_update_gate(hidden_size: int) -> [7 * hidden_size] {
    accum_blocks(
        { slice(hidden_size, hidden_size) },
        { slice(4 * hidden_size, hidden_size) }
    )
    sigmoid()
}

/**
 * Candidate state over [gi | gh | h]: n = tanh(gi_n + r ⊙ gh_n),
 * [7 * hidden_size] -> [hidden_size]. The reset gate scales only the hidden state's term.
 *
 *   accum_blocks
 *     gi_n                          offset 2 * hidden_size
 *     product(r, gh_n)              gru_reset_gate ⊙ gh_n (offset 5 * hidden_size)
 *   tanh_act
 */
layer gru_candidate(hidden_size: int) -> [7 * hidden_size] {
    accum_blocks(
        { slice(2 * hidden_size, hidden_size) },
        product(
            { gru_reset_gate(hidden_size) },
            { slice(5 * hidden_size, hidden_size) }
        )
    )
    tanh_act()
}

/**
 * Logits head: the last GRU layer's hidden state [hidden_size] -> logits over the flat decode
 * vocabulary [decode_vocab_size].
 */
layer gru_decoder_logits(lm_head_weight: weight, lm_head_bias: weight) {
    dense(lm_head_weight, lm_head_bias)
}

/**
 * Logits head of checkpoints with an fc_out projection between the GRU and the vocabulary
 * head: [hidden_size] -> [hidden_size] -> [decode_vocab_size].
 *
 *   dense(fc_out_weight, fc_out_bias)       [hidden_size]
 *   dense(lm_head_weight, lm_head_bias)     [decode_vocab_size]
 */
layer gru_decoder_logits_fc_out(fc_out_weight: weight, fc_out_bias: weight,
                                lm_head_weight: weight, lm_head_bias: weight) {
    dense(fc_out_weight, fc_out_bias)
    dense(lm_head_weight, lm_head_bias)
}
