    layernorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores_softcapped(keys, key_mask, head_dim, softcap)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Causal self-attention with a LayerNorm of every query and key row, soft-capped scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_layernorm_softcapped, with the causal
 * score half.
 */
layer sequence_attention_qk_layernorm_softcapped_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                                        qkv_projection: projection, out_projection: projection,
                                                        q_norm_weight: weight, q_norm_bias: weight,
                                                        k_norm_weight: weight, k_norm_bias: weight,
                                                        inv_freq: weight, padding_mask: weight,
                                                        key_mask: weight, softcap: float) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        layernorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    layernorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores_softcapped_causal(keys, key_mask, head_dim, softcap)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Self-attention with an RMSNorm of every query and key row before the rotation, plain scores
 * (a diffusion transformer trained with RMS normalization): [batch, seq_len, dim] -> same. As
 * sequence_attention, with one stage added on each of the query and key paths:
 *
 *   rmsnorm(norm weight, norm bias, 1e-6)     each head_dim row divided by its root mean square,
 *                                             then scaled (and shifted when a bias is bound; bind
 *                                             null for none); applied after head_rows and before
 *                                             sequence_rope
 */
layer sequence_attention_qk_rmsnorm(batch: int, seq_len: int, heads: int, head_dim: int,
                                    qkv_projection: projection, out_projection: projection,
                                    q_norm_weight: weight, q_norm_bias: weight,
                                    k_norm_weight: weight, k_norm_bias: weight,
                                    inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        rmsnorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    rmsnorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Causal self-attention with an RMSNorm of every query and key row, plain scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_rmsnorm, with the causal score half.
 */
layer sequence_attention_qk_rmsnorm_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                           qkv_projection: projection, out_projection: projection,
                                           q_norm_weight: weight, q_norm_bias: weight,
                                           k_norm_weight: weight, k_norm_bias: weight,
                                           inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        rmsnorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    rmsnorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores_causal(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Self-attention with an RMSNorm of every query and key row, soft-capped scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_rmsnorm, with sdpa_scores_softcapped
 * in place of sdpa_scores.
 */
layer sequence_attention_qk_rmsnorm_softcapped(batch: int, seq_len: int, heads: int, head_dim: int,
                                               qkv_projection: projection, out_projection: projection,
                                               q_norm_weight: weight, q_norm_bias: weight,
                                               k_norm_weight: weight, k_norm_bias: weight,
