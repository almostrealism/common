/**
 * Causal self-attention with an RMSNorm of every query and key row, soft-capped scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_rmsnorm_softcapped, with the causal score
 * half.
 */
layer sequence_attention_qk_rmsnorm_softcapped_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                                      qkv_projection: projection, out_projection: projection,
                                                      q_norm_weight: weight, q_norm_bias: weight,
                                                      k_norm_weight: weight, k_norm_bias: weight,
                                                      inv_freq: weight, padding_mask: weight,
                                                      key_mask: weight, softcap: float) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        rmsnorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
