/**
 * Parallel (full-sequence) multi-head self-attention with rotary position embeddings: every position
 * of a [batch, seq_len, dim] sequence attends to positions of the same sequence in one forward pass —
 * to every position (bidirectional: the self-attention of the Stable Audio diffusion transformer's
 * blocks and of the T5Gemma text encoder), or only to itself and the positions before it (causal: the
 * self-attention of a decoder language model trained on whole sequences).
 *
 * This file replaces the Java assembly that used to live in SequenceAttentionFeatures.sequenceAttention,
 * which built these stages as a SequentialBlock. sequenceAttention now only builds the two projections
 * from its projection factory, binds the arguments and builds one of the layers below, so the structure
 * is defined once, here, for inference and training alike.
 *
 * It is the full-sequence counterpart of the autoregressive `attention` layer of /pdsl/attention.pdsl,
 * which scores one token against a growing key/value cache; here the keys and values of the whole
 * sequence are computed in the same pass as the queries. The score and context halves are the layers
 * of /pdsl/sdpa.pdsl, which this file imports.
 *
 * Data flow of one forward pass (dim = heads * head_dim):
 *
 *   [batch, seq_len, dim] sequence
 *     qkv_projection                                         [batch, seq_len, 3 * dim]
 *     reshape                                                [batch, seq_len, 3, dim]
 *     ├─ keys:   head_rows(1) → [norm] → sequence_rope       [batch, heads, seq_len, head_dim]
 *     ├─ values: value_rows(padding_mask)                    [batch, heads, seq_len, head_dim]
 *     └─ query:  head_rows(0) → [norm] → sequence_rope       [batch, heads, seq_len, head_dim]
 *          sdpa_scores(keys, key_mask)   softmax(Q Kᵀ / sqrt(head_dim)), masked
 *                                                            [batch, heads, seq_len, seq_len]
 *          sdpa_context(values)          weights · V         [batch, heads, seq_len, head_dim]
 *          merge_heads                                       [batch, seq_len, dim]
 *          out_projection                                    [batch, seq_len, dim]
 *
 * The keys and values branches split off the projected sequence before the query path continues. The
 * score half takes the keys branch as the second operand of Q Kᵀ, and the context half takes the values
 * branch as the second operand of A V, so a backward pass carries gradients back through both branches
 * into the key and value thirds of qkv_projection, as well as along the query path.
 *
 * The projections. qkv_projection and out_projection are layers the caller builds from its weights
 * and binds like a weight: plain dense layers, or adapter-wrapped ones when the model is being
 * fine-tuned. The adapter decision belongs to the training setup, not to the attention's structure,
 * and the language has no construct for a projection the host may adapt, so the two projections
 * arrive as layers and appear below as the first and last stages.
 *
 * The masks. padding_mask is one validity value per position, [batch, seq_len], one for a real
 * position and zero for padding; it zeroes the padded positions' values, which still occupy their
 * softmax slots (value masking). key_mask has the same shape and removes masked keys from the softmax
 * entirely (logit masking, the key_mask stage of the score half). A caller without padding binds
 * all-ones masks, which leave every value and every score unchanged.
 *
 * The twelve layers. The structure has three optional parts: the query/key normalization (none,
 * LayerNorm or RMSNorm, applied to every head_dim row of the queries and keys), the logit soft-cap of
 * the score half, and causal masking. Each combination is its own layer, so a reader sees exactly the
 * stages a model runs:
 *
 *   query/key norm   plain scores                       soft-capped scores
 *   none             sequence_attention                 sequence_attention_softcapped
 *   LayerNorm        sequence_attention_qk_layernorm    sequence_attention_qk_layernorm_softcapped
 *   RMSNorm          sequence_attention_qk_rmsnorm      sequence_attention_qk_rmsnorm_softcapped
 *
 * and the causal form of each, named with a _causal suffix (sequence_attention_causal,
 * sequence_attention_qk_rmsnorm_softcapped_causal, ...), which scores with the causal score half of
 * /pdsl/sdpa.pdsl. The Stable Audio diffusion transformer runs sequence_attention_qk_layernorm, the
 * T5Gemma encoder sequence_attention_softcapped and a decoder language model sequence_attention_causal.
 * The query/key normalizations use an epsilon of 1e-6.
 */

import "/pdsl/sdpa.pdsl"

/**
 * One third of the fused projection, laid out one row per head:
 * [batch, seq_len, 3, dim] -> [batch, heads, seq_len, head_dim]. Section 0 holds the queries,
 * section 1 the keys and section 2 the values.
 *
 *   slice      the section's third                          [batch, seq_len, 1, dim]
 *   reshape    each position's dim split into heads         [batch, seq_len, heads, head_dim]
 *   permute    heads ahead of positions                     [batch, heads, seq_len, head_dim]
 */
layer head_rows(batch: int, seq_len: int, heads: int, head_dim: int, section: int) {
    slice([batch, seq_len, 1, heads * head_dim], 0, 0, section, 0)
    reshape([batch, seq_len, heads, head_dim])
    permute(0, 2, 1, 3)
}

/**
 * The values, one row per head, with the rows of every padded position zeroed:
 * [batch, seq_len, 3, dim] -> [batch, heads, seq_len, head_dim].
 *
 *   head_rows(2)              the values third, one row per head
 *   scale(padding_mask, 2)    each position's rows times its validity (axis 2 is the position)
 */
layer value_rows(batch: int, seq_len: int, heads: int, head_dim: int, padding_mask: weight) {
    head_rows(batch, seq_len, heads, head_dim, 2)
    scale(padding_mask, 2)
}

/**
 * The attended rows back in the sequence layout:
 * [batch, heads, seq_len, head_dim] -> [batch, seq_len, dim].
 *
 *   permute    positions ahead of heads                     [batch, seq_len, heads, head_dim]
 *   reshape    each position's heads joined                 [batch, seq_len, dim]
 */
layer merge_heads(batch: int, seq_len: int, heads: int, head_dim: int) {
    permute(0, 2, 1, 3)
    reshape([batch, seq_len, heads * head_dim])
}

/**
 * Self-attention without query/key normalization, plain scores: [batch, seq_len, dim] -> same.
 *
 *   qkv_projection            queries, keys and values side by side   [batch, seq_len, 3 * dim]
 *   reshape                   one dim-wide section each               [batch, seq_len, 3, dim]
 *   keys:   head_rows(1)      the keys, one row per head              [batch, heads, seq_len, head_dim]
 *           sequence_rope     each row rotated by its position
 *   values: value_rows        the values, padded positions zeroed     [batch, heads, seq_len, head_dim]
 *   head_rows(0)              the queries, one row per head           [batch, heads, seq_len, head_dim]
 *   sequence_rope             each row rotated by its position
 *   sdpa_scores(keys)         softmax over the keys of the key-masked Q Kᵀ / sqrt(head_dim)
 *                                                                     [batch, heads, seq_len, seq_len]
 *   sdpa_context(values)      the weights times the values            [batch, heads, seq_len, head_dim]
 *   merge_heads               the heads of each position joined       [batch, seq_len, dim]
 *   out_projection            the output projection                   [batch, seq_len, dim]
 */
layer sequence_attention(batch: int, seq_len: int, heads: int, head_dim: int,
                         qkv_projection: projection, out_projection: projection,
                         inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    sequence_rope(inv_freq)
    sdpa_scores(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Causal self-attention without query/key normalization, plain scores (a decoder language model):
 * [batch, seq_len, dim] -> same. As sequence_attention, with the causal score half, so each position
 * attends only to itself and the positions before it.
 */
layer sequence_attention_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                qkv_projection: projection, out_projection: projection,
                                inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    sequence_rope(inv_freq)
    sdpa_scores_causal(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Self-attention without query/key normalization, soft-capped scores (T5Gemma):
 * [batch, seq_len, dim] -> same. As sequence_attention, with the scaled logits squashed to
 * softcap * tanh(logit / softcap) before the key mask.
 */
layer sequence_attention_softcapped(batch: int, seq_len: int, heads: int, head_dim: int,
                                    qkv_projection: projection, out_projection: projection,
                                    inv_freq: weight, padding_mask: weight, key_mask: weight,
                                    softcap: float) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    sequence_rope(inv_freq)
    sdpa_scores_softcapped(keys, key_mask, head_dim, softcap)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Causal self-attention without query/key normalization, soft-capped scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_softcapped, with the causal score half.
 */
layer sequence_attention_softcapped_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                           qkv_projection: projection, out_projection: projection,
                                           inv_freq: weight, padding_mask: weight, key_mask: weight,
                                           softcap: float) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    sequence_rope(inv_freq)
    sdpa_scores_softcapped_causal(keys, key_mask, head_dim, softcap)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Self-attention with a LayerNorm of every query and key row before the rotation, plain scores
 * (the Stable Audio diffusion transformer): [batch, seq_len, dim] -> same. As sequence_attention,
 * with one stage added on each of the query and key paths:
 *
 *   layernorm(norm weight, norm bias, 1e-6)   each head_dim row to zero mean and unit variance,
 *                                             then scaled and shifted; applied after head_rows and
 *                                             before sequence_rope
 */
layer sequence_attention_qk_layernorm(batch: int, seq_len: int, heads: int, head_dim: int,
                                      qkv_projection: projection, out_projection: projection,
                                      q_norm_weight: weight, q_norm_bias: weight,
                                      k_norm_weight: weight, k_norm_bias: weight,
                                      inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        layernorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    layernorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Causal self-attention with a LayerNorm of every query and key row, plain scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_layernorm, with the causal score half.
 */
layer sequence_attention_qk_layernorm_causal(batch: int, seq_len: int, heads: int, head_dim: int,
                                             qkv_projection: projection, out_projection: projection,
                                             q_norm_weight: weight, q_norm_bias: weight,
                                             k_norm_weight: weight, k_norm_bias: weight,
                                             inv_freq: weight, padding_mask: weight, key_mask: weight) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        layernorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
    }
    branch values {
        value_rows(batch, seq_len, heads, head_dim, padding_mask)
    }

    head_rows(batch, seq_len, heads, head_dim, 0)
    layernorm(q_norm_weight, q_norm_bias, 1e-6)
    sequence_rope(inv_freq)
    sdpa_scores_causal(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, seq_len, heads, head_dim)
    out_projection
}

/**
 * Self-attention with a LayerNorm of every query and key row, soft-capped scores:
 * [batch, seq_len, dim] -> same. As sequence_attention_qk_layernorm, with sdpa_scores_softcapped
 * in place of sdpa_scores.
 */
layer sequence_attention_qk_layernorm_softcapped(batch: int, seq_len: int, heads: int, head_dim: int,
                                                 qkv_projection: projection, out_projection: projection,
                                                 q_norm_weight: weight, q_norm_bias: weight,
                                                 k_norm_weight: weight, k_norm_bias: weight,
                                                 inv_freq: weight, padding_mask: weight,
                                                 key_mask: weight, softcap: float) {
    qkv_projection
    reshape([batch, seq_len, 3, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 1)
        layernorm(k_norm_weight, k_norm_bias, 1e-6)
        sequence_rope(inv_freq)
