/**
 * Multi-head attention pooling (MAP): a learned latent query attends over every position of a
 * [batch, seq_len, dim] sequence and the result is one pooled [batch, 1, dim] vector. This is the
 * pooling head of SigLIP-style vision towers (timm's AttentionPoolLatent) and of the CLAP2 audio and
 * text towers: it replaces a CLS token or a mean with a learned, content-dependent weighting.
 *
 * Data flow (dim = heads * head_dim):
 *
 *   [batch, seq_len, dim] sequence
 *     kv_projection                                          [batch, seq_len, 2 * dim]
 *     reshape                                                [batch, seq_len, 2, dim]
 *     ├─ keys:   head_rows(0) → [norm]                       [batch, heads, seq_len, head_dim]
 *     └─ values: head_rows(1)                                [batch, heads, seq_len, head_dim]
 *     cache_read(latent, 0)    the learned query, the stage input is not read      [dim]
 *     reshape → q_projection → per-head row → [norm]         [batch, heads, 1, head_dim]
 *     sdpa_scores(keys, key_mask)   softmax(q Kᵀ / sqrt(head_dim)), masked           [batch, heads, 1, seq_len]
 *     sdpa_context(values)                                   [batch, heads, 1, head_dim]
 *     merge_heads                                            [batch, 1, dim]
 *
 * The query does not depend on the sequence: it is the q projection of the latent, a [1, dim]
 * weight that cache_read places on the main path after the key and value branches have split off
 * the sequence. The batch is therefore 1 (one latent row is read). key_mask, [batch, seq_len], is
 * one for a position the pool may read and zero for one it may not: padding, or a prefix token the
 * model excludes from pooling.
 *
 * The output projection and any feed-forward that follows the pooled vector belong to the caller,
 * which differs between models (timm adds an output projection and a residual MLP; the CLAP2 text
 * tower adds neither).
 *
 * There are two layers. attention_pool uses plain projections (bound with or without biases);
 * attention_pool_qk_rmsnorm also RMS-normalizes every query and key row over head_dim (epsilon 1e-6)
 * before scoring, as the CLAP2 text tower's pool does.
 */

import "/pdsl/sequence_attention.pdsl"

/**
 * Attention pooling with plain query and key rows: [batch, seq_len, dim] -> [batch, 1, dim].
 *
 *   kv_projection, reshape           keys and values side by side       [batch, seq_len, 2, dim]
 *   keys:   head_rows(0)             one row per head                   [batch, heads, seq_len, head_dim]
 *   values: head_rows(1)             one row per head                   [batch, heads, seq_len, head_dim]
 *   cache_read(latent, 0)            the learned query latent           [dim]
 *   reshape, q_projection            the projected query                [batch, 1, dim]
 *   reshape, permute                 one row per head                   [batch, heads, 1, head_dim]
 *   sdpa_scores, sdpa_context        the masked attention over the sequence
 *   merge_heads                      the heads joined                   [batch, 1, dim]
 *
 * batch must be 1: the latent is a single [dim] row and is not broadcast, so for a larger batch
 * the reshape after cache_read has more elements than its input and the layer fails to build.
 */
layer attention_pool(batch: int, seq_len: int, heads: int, head_dim: int,
                     latent: weight, q_projection: projection, kv_projection: projection,
                     key_mask: weight) {
    kv_projection
    reshape([batch, seq_len, 2, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 0)
    }
    branch values {
        head_rows(batch, seq_len, heads, head_dim, 1)
    }

    cache_read(latent, 0)
    reshape([batch, 1, heads * head_dim])
    q_projection
    reshape([batch, 1, heads, head_dim])
    permute(0, 2, 1, 3)
    sdpa_scores(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, 1, heads, head_dim)
}

/**
 * Attention pooling with RMS-normalized query and key rows: [batch, seq_len, dim] -> [batch, 1, dim].
 * As attention_pool, with one stage added on each of the query and key paths:
 *
 *   rmsnorm(norm weight, null, 1e-6)   each head_dim row divided by its root mean square and scaled;
 *                                      applied after the rows are laid out per head
 *
 * batch must be 1, as for attention_pool.
 */
layer attention_pool_qk_rmsnorm(batch: int, seq_len: int, heads: int, head_dim: int,
                                latent: weight, q_projection: projection, kv_projection: projection,
                                q_norm_weight: weight, k_norm_weight: weight, key_mask: weight) {
    kv_projection
    reshape([batch, seq_len, 2, heads * head_dim])

    branch keys {
        head_rows(batch, seq_len, heads, head_dim, 0)
        rmsnorm(k_norm_weight, null, 1e-6)
    }
    branch values {
        head_rows(batch, seq_len, heads, head_dim, 1)
    }

    cache_read(latent, 0)
    reshape([batch, 1, heads * head_dim])
    q_projection
    reshape([batch, 1, heads, head_dim])
    permute(0, 2, 1, 3)
    rmsnorm(q_norm_weight, null, 1e-6)
    sdpa_scores(keys, key_mask, head_dim)
    sdpa_context(values)
    merge_heads(batch, 1, heads, head_dim)
}
