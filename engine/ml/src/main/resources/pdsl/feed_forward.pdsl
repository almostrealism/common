/**
 * SwiGLU feed-forward network — the position-wise MLP sub-layer of a transformer block.
 *
 * This file replaces the Java assembly that used to live in
 * FeedForwardFeatures.feedForward(...), which built this same structure as a SequentialBlock
 * (rmsnorm, two parallel dense projections, a SiLU gate, an element-wise product and a down
 * projection). The Java feedForward(rms, w1, w2, w3[, epsilon]) methods now only bind the
 * weights and load this asset, so there is one definition of the structure and it is here.
 *
 * Data flow of one forward pass. The input is the residual-stream vector [1, dim]:
 *
 *   [1, dim] token vector
 *     └─ rmsnorm(norm_weights, epsilon)                          [1, dim]
 *        ├─ gate: dense(w1) → silu()                             [1, hidden_dim]
 *        └─ up:   dense(w3)                                      [1, hidden_dim]
 *        product(gate, up)   (element-wise, one multiply)        [1, hidden_dim]
 *     └─ dense(w2)                                               [1, dim]
 *
 * SwiGLU: FFN(x) = w2 · ( silu(w1 · rmsnorm(x)) ⊙ (w3 · rmsnorm(x)) ). The gate and up
 * projections both read the normalized vector; the down projection maps the gated hidden
 * activation back to the model dimension. w1 is the gate projection [hidden_dim, dim], w3 the
 * up projection [hidden_dim, dim] and w2 the down projection [dim, hidden_dim]. This is the
 * standard Llama/Qwen MLP; the transformer stacks wrap it in a residual branch (see the
 * accum-wrapped feed-forward in skytnt_block.pdsl).
 *
 * Stage 1 rmsnorm normalizes the residual stream to [1, dim]. Stage 2 product forms the gated
 * hidden activation [1, hidden_dim] as the SiLU-gated gate path (w1) times the linear up path
 * (w3), both reading the normalized vector. Stage 3 dense(w2) projects back to [1, dim].
 */
layer swiglu_ffn(norm_weights: weight, w1: weight, w2: weight, w3: weight, epsilon: float) {
    rmsnorm(norm_weights, epsilon)
    product(
        { dense(w1); silu() },
        { dense(w3) }
    )
    dense(w2)
}

/**
 * Gated-linear-unit feed-forward body — the fused-projection sibling of swiglu_ffn, shared by
 * the diffusion-transformer and T5Gemma feed-forward sub-layers.
 *
 * This layer replaces the Java assembly that used to live in
 * FeedForwardFeatures.gatedLinearFeedForward(...), which built this same gating as a
 * SequentialBlock: a fused gate+linear projection, a split of its output into two equal halves,
 * an activation on the gate half, the element-wise product of the two halves and a down
 * projection. The gating composition has one definition and it is here.
 *
 * The pre-normalization is NOT a stage of this body, because the sub-layers that use it normalize
 * differently: the gated_linear_feed_forward_* layers below put a LayerNorm or an RMSNorm, and in
 * their adaLN variants a feature-wise modulation, ahead of it; t5gemma_feed_forward and
 * causal_lm_feed_forward an RMSNorm; resampling_transformer_layer a DynamicTanh. Keeping the norm
 * out lets every one of them share this single gating definition rather than duplicating it.
 *
 * in_projection and out_projection arrive as projection layers — a plain dense projection, or an
 * adapter-wrapped one when the model is being fine-tuned. The adapter decision belongs to the
 * training setup, not to the gating structure, and the language has no construct for a projection
 * the host may adapt, so the projections arrive as layers, exactly as in sequence_attention.pdsl.
 * gate_activation is the activation of the gate half — SiLU for a SwiGLU, GELU for a GeGLU —
 * likewise a bound layer, since the language names neither a norm family nor an activation as a
 * value a stage can select.
 *
 * Data flow of one forward pass over an already-normalized [batch, seq_len, dim] activation:
 *
 *   in_projection                             the fused projection      [batch, seq_len, 2 * inner_dim]
 *   product(                                  (element-wise, one multiply)
 *     { slice linear half }                   the first inner_dim       [batch, seq_len, inner_dim]
 *     { slice gate half; gate_activation }    the next inner_dim, activated
 *   )                                                                   [batch, seq_len, inner_dim]
 *   out_projection                            the down projection       [batch, seq_len, dim]
 *
 * GLU(x) = out_projection( x_linear ⊙ gate_activation(x_gate) ), where [x_linear | x_gate] is the
 * fused projection of the input: its first inner_dim features are the linear half and the next
 * inner_dim the gate half.
 */
layer glu_feed_forward(in_projection: projection, out_projection: projection,
                       gate_activation: activation,
                       batch: int, seq_len: int, inner_dim: int) {
    in_projection
    product(
        { slice([batch, seq_len, inner_dim], 0, 0, 0) },
        { slice([batch, seq_len, inner_dim], 0, 0, inner_dim); gate_activation }
    )
    out_projection
}

/**
 * Gated-linear feed-forward sub-layer of a diffusion transformer block: the pre-normalization, the
 * adaptive-layernorm (adaLN) modulation when the block is conditioned that way, and the
 * glu_feed_forward gating body above. There is one layer per normalization family and modulation:
 *
 *   gated_linear_feed_forward_layernorm              LayerNorm
 *   gated_linear_feed_forward_layernorm_modulated    LayerNorm, then the adaLN modulation
 *   gated_linear_feed_forward_rmsnorm                RMSNorm
 *   gated_linear_feed_forward_rmsnorm_modulated      RMSNorm, then the adaLN modulation
 *
 * These layers replace the Java assembly that used to live in
 * FeedForwardFeatures.gatedLinearFeedForward(...), which built the normalization of the family a
 * NormalizationType argument chose and, when it was given a modulation, an adaLN modulation stage,
 * as a SequentialBlock ahead of glu_feed_forward. Which norm runs and whether the activation is
 * modulated are now read off the layer instead of being decided inside that method, which only
 * builds the two projections (dense, or adapter-wrapped for fine-tuning), binds the weights, the
 * family's default epsilon (NormalizationType.defaultEpsilon: 1e-5 for RMSNorm, the hardware
 * precision's epsilon for LayerNorm) and the modulation, and loads the layer the call names. The
 * diffusion transformer runs the LayerNorm layers for a LayerNorm checkpoint and the RMSNorm
 * layers for an RMSNorm checkpoint (Stable Audio 3, whose norms carry no bias, so norm_biases is
 * null), the _modulated forms in its adaLN conditioning mode.
 *
 * The modulation is feature-wise (FiLM): modulate(mod_scale, mod_shift, 2) multiplies every
 * channel of every position by its batch entry's factor and adds its batch entry's offset,
 * n' = mod_scale ⊙ n + mod_shift, with mod_scale and mod_shift [batch, dim], one value per batch
 * entry and channel, broadcast across the sequence (axis 2 of the activation is the channel). The
 * diffusion transformer computes them from its conditioning vector, mod_scale = 1 + scale_ff and
 * mod_shift = shift_ff of the adaLN-Zero modulation, and binds them as producers it refreshes
 * before every forward pass. They are constants of the graph, so no gradient reaches the
 * conditioning through them.
 *
 * Data flow of one forward pass over a [batch, seq_len, dim] activation:
 *
 *   x                                                                       [batch, seq_len, dim]
 *     layernorm | rmsnorm    each position normalized over its dim features [batch, seq_len, dim]
 *     modulate(mod_scale, mod_shift, 2)
 *                            each channel times its factor, plus its offset
 *                                                              (_modulated) [batch, seq_len, dim]
 *     glu_feed_forward       in_projection → linear half ⊙ gate_activation(gate half)
 *                            → out_projection                               [batch, seq_len, dim]
 *
 * The residual connection around the sub-layer, and in adaLN mode the gate on its output, belong
 * to the transformer block that uses it.
 */
layer gated_linear_feed_forward_layernorm(batch: int, seq_len: int, inner_dim: int,
                                          norm_weights: weight, norm_biases: weight, epsilon: float,
                                          in_projection: projection, out_projection: projection,
                                          gate_activation: activation) {
    layernorm(norm_weights, norm_biases, epsilon)
    glu_feed_forward(in_projection, out_projection, gate_activation, batch, seq_len, inner_dim)
}

/** LayerNorm, the adaLN modulation, then the gating body: [batch, seq_len, dim] -> same. */
layer gated_linear_feed_forward_layernorm_modulated(batch: int, seq_len: int, dim: int, inner_dim: int,
                                                    norm_weights: weight, norm_biases: weight,
                                                    epsilon: float,
                                                    mod_scale: producer([batch, dim]),
                                                    mod_shift: producer([batch, dim]),
                                                    in_projection: projection,
                                                    out_projection: projection,
                                                    gate_activation: activation) {
    layernorm(norm_weights, norm_biases, epsilon)
    modulate(mod_scale, mod_shift, 2)
    glu_feed_forward(in_projection, out_projection, gate_activation, batch, seq_len, inner_dim)
}

/** RMSNorm, then the gating body: [batch, seq_len, dim] -> same. */
layer gated_linear_feed_forward_rmsnorm(batch: int, seq_len: int, inner_dim: int,
                                        norm_weights: weight, norm_biases: weight, epsilon: float,
                                        in_projection: projection, out_projection: projection,
                                        gate_activation: activation) {
    rmsnorm(norm_weights, norm_biases, epsilon)
    glu_feed_forward(in_projection, out_projection, gate_activation, batch, seq_len, inner_dim)
}

/** RMSNorm, the adaLN modulation, then the gating body: [batch, seq_len, dim] -> same. */
layer gated_linear_feed_forward_rmsnorm_modulated(batch: int, seq_len: int, dim: int, inner_dim: int,
                                                  norm_weights: weight, norm_biases: weight,
                                                  epsilon: float,
                                                  mod_scale: producer([batch, dim]),
                                                  mod_shift: producer([batch, dim]),
                                                  in_projection: projection,
                                                  out_projection: projection,
                                                  gate_activation: activation) {
    rmsnorm(norm_weights, norm_biases, epsilon)
    modulate(mod_scale, mod_shift, 2)
    glu_feed_forward(in_projection, out_projection, gate_activation, batch, seq_len, inner_dim)
}
