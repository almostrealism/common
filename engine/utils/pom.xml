<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>common</artifactId>
		<groupId>org.almostrealism</groupId>
		<version>0.78</version>
		<relativePath>../../pom.xml</relativePath>
	</parent>
	<modelVersion>4.0.0</modelVersion>

	<artifactId>ar-utils</artifactId>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!--
				Register a JUnit RunListener that logs a flushed breadcrumb as each test
				starts and finishes, so an intermittent forked-JVM crash in this module
				still names the running test in the console log even when surefire's own
				"Crashed tests" summary is empty (the fault occurs in a detached worker
				after the test thread reported finished). Merges with the inherited
				surefire configuration from the root pom; argLine and the other settings
				there are kept.
				-->
				<configuration>
					<properties>
						<property>
							<name>listener</name>
							<value>org.almostrealism.util.CrashAttributionRunListener</value>
						</property>
					</properties>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<dependencies>
		<dependency>
			<groupId>org.almostrealism</groupId>
			<artifactId>ar-space</artifactId>
			<version>0.78</version>
		</dependency>

		<dependency>
			<groupId>org.almostrealism</groupId>
			<artifactId>ar-chemistry</artifactId>
			<version>0.78</version>
		</dependency>

		<dependency>
			<groupId>org.almostrealism</groupId>
			<artifactId>ar-optimize</artifactId>
			<version>0.78</version>
		</dependency>

		<dependency>
			<groupId>org.almostrealism</groupId>
			<artifactId>ar-hardware-js</artifactId>
			<version>0.78</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>compile</scope>
		</dependency>
	</dependencies>
</project>